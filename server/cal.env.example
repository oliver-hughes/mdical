# Copied to /opt/cal/cal.env by bootstrap.sh, then edited. Sourced by run.sh, so
# it is shell, not ini - no spaces around `=`.

# Where everything lives. The defaults match the layout bootstrap.sh creates.
CAL_ROOT=/opt/cal
MDICAL=$CAL_ROOT/mdical
VDIR=$CAL_ROOT/vdir
STATE=$CAL_ROOT/state

# The git checkout, and the directory inside it that mdical scans. These are two
# different things, and conflating them is a mistake with quiet consequences:
# oliver-hughes/vaults holds `brain`, `main` and `ops` side by side, so a scanner
# pointed at the repo root reads all three - including any markers in notes you
# never meant to publish.
#
# git runs at VAULT_REPO; the scan and every write happen under VAULT. The commit
# is scoped to VAULT too, so uncommitted work anywhere else in the repo is left
# alone rather than swept into a nightly commit about phone completions.
VAULT_REPO=$CAL_ROOT/vault
VAULT=$VAULT_REPO/brain

# Who the nightly commits are from. They are machine commits and should look it:
# when you see this name in `git log` you know the box wrote it, not you.
GIT_NAME=mdical
GIT_EMAIL=mdical@localhost

# A dead man's switch - healthchecks.io, or anything that alerts when it stops
# being called. Empty disables it. A container that has been down a week should
# be noticed, and nothing else will notice for you.
#
# It is pinged only on a fully clean run. A push that failed still leaves a
# correct calendar, so the run keeps going - but it deliberately does not ping.
HEALTHCHECK=

# How many times to rebase-and-retry a rejected push before giving up.
PUSH_ATTEMPTS=3

# The CalDAV user. Must match the htpasswd entry and the vdirsyncer config.
CAL_USER=hugheso
