# Installed to ~/.config/vdirsyncer/config for the user that runs run.sh.
#
# Two pairs, one per collection, filesystem <-> caldav. `a` is always the local
# vdir, which is to say markdown.

[general]
status_path = "/opt/cal/state/vdirsyncer"

# ------------------------------------------------------------------------ tasks

[pair tasks]
a = "tasks_local"
b = "tasks_dav"

# The storages point straight at one collection each, so there is nothing to
# discover a list of.
collections = null

# The one setting that matters. `a` is the local vdir, which is generated from
# markdown, so this encodes *markdown owns everything except completion*.
#
# It is also the answer to the question M0's B10 left open: an event edited on
# the phone is overwritten on the next run. That is decided behaviour, not an
# accident. If it turns out to be irritating, radicale's [rights] can make the
# events collection read-only to the phone so the edit is refused up front
# rather than silently lost.
#
# Completion is the exception that survives, and it survives because the ratchet
# reads it out of the vdir *before* the rebuild overwrites it - not because
# vdirsyncer preserves it.
conflict_resolution = "a wins"

[storage tasks_local]
type = "filesystem"
path = "/opt/cal/vdir/cal-tasks"
fileext = ".ics"

[storage tasks_dav]
type = "caldav"
url = "http://localhost:5232/hugheso/cal-tasks/"
username = "hugheso"
# Not the password itself: the file is 0600 and owned by the cal user, and this
# config lands in a git-tracked repo.
password.fetch = ["command", "cat", "/opt/cal/secrets/caldav-password"]
# Without this the tasks pair also drags in events, and both collections end up
# holding both component types.
item_types = ["VTODO"]

# ----------------------------------------------------------------------- events

[pair events]
a = "events_local"
b = "events_dav"
collections = null
conflict_resolution = "a wins"

[storage events_local]
type = "filesystem"
path = "/opt/cal/vdir/cal-events"
fileext = ".ics"

[storage events_dav]
type = "caldav"
url = "http://localhost:5232/hugheso/cal-events/"
username = "hugheso"
password.fetch = ["command", "cat", "/opt/cal/secrets/caldav-password"]
item_types = ["VEVENT"]
