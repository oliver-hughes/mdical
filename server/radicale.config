; Installed to /etc/radicale/config.
;
; Two departures from the M0 spike's config, both deliberate.

[server]
; NOT 0.0.0.0. The spike needed that because the phone talked to radicale
; directly over the LAN; here `tailscale serve` proxies from localhost, so
; nothing outside this container ever needs to reach the port. vdirsyncer talks
; to it over localhost too, which is also why there is no TLS here - tailscale
; terminates it.
hosts = localhost:5232

[auth]
; The spike used `type = none` and accepted any password, which was fine for an
; afternoon on a LAN and is not fine for something reachable from a phone.
type = htpasswd
htpasswd_filename = /etc/radicale/users
htpasswd_encryption = bcrypt

[storage]
filesystem_folder = /var/lib/radicale/collections

[logging]
; The spike ran at debug to watch what the phone sent, which is most of what it
; produced. Turn it back up if the phone starts doing something inexplicable -
; `journalctl -u radicale -f` while pulling to refresh is the whole technique.
level = info
